" 1. SETTINGS & PLUGINS (Must come FIRST)
set surround
set multiple-cursors
set visualbell
set ideamarks

"" 2. MAP LEADER
let mapleader = "§"

"" 3. MAPPINGS (Use non-recursive 'nnoremap' for Normal mode actions)
imap jk <ESC>

" Toggle relative / absolute line numbers
nnoremap \, :set nu! \| set relativenumber!<CR>

" Window controls
nnoremap <leader>on :action VimWindowOnly<CR>
nnoremap <leader>q  :action VimWindowClose<CR>

" Window navigation
nnoremap <C-h> <C-w>h
nnoremap <C-j> <C-w>j
nnoremap <C-k> <C-w>k
nnoremap <C-l> <C-w>l

" Markdown View shortcuts (2026-09-29, ended up doing as regular
" shortcuts
"nnoremap \mv :action TextEditorWithPreview.LayoutGroup<CR>
"nnoremap \m1 :action TextEditorWithPreview.Layout.EditorOnly<CR>
"nnoremap \m2 :action TextEditorWithPreview.Layout.EditorAndPreview<CR>
"nnoremap \m3 :action TextEditorWithPreview.Layout.PreviewOnly<CR>

" Folding
"nnoremap zR :action ExpandAllRegions<CR>:action ExpandAllRegions<CR>
